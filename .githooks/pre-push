#!/usr/bin/env bash
# stapel-hooks: pre-push v1
# Scan WHAT IS BEING PUSHED, never the working tree: git names each ref on
# stdin, and the committed tree behind it is the only thing this push can
# publish. Scanning "." made two sessions sharing one worktree block each
# other — a peer's uncommitted files failed the other's push.
set -eo pipefail

zero='0000000000000000000000000000000000000000'
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# git passes the remote name as $1 and its URL as $2.
remote_name="${1:-origin}"
default_branch=''
default_sha=''
default_fetched=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # nothing to push, or a deletion: no tree to judge
    if [ -z "$local_sha" ] || [ "$local_sha" = "$zero" ]; then
        continue
    fi

    # ── Stage 1 — branch-contains-default ────────────────────────────────
    # A branch cut from a base hundreds of commits old does not revert
    # anything while it sits on a laptop; it reverts everything that landed
    # on the default branch in the meantime the moment it is merged, and
    # nothing about that merge looks wrong. So the push is the last honest
    # moment to ask the question: refuse until the default branch has been
    # MERGED into the branch and the conflicts resolved by the person who
    # knows both sides. Rebasing a published branch is not the fix — it
    # rewrites history other clones already have and still drops nothing
    # into the conflict resolution.
    #
    # Skipped for tags, for deletions, and for pushes whose REMOTE ref is
    # the default branch itself (git already enforces fast-forward there).
    # There is no environment-variable escape hatch, by design.
    #
    # POSIX sh only in this stage (no bashisms, no GNU-only flags): it is
    # copied by hand into hooks that run under Git for Windows' sh.
    check_contains=1
    case "$local_ref" in
        refs/tags/*) check_contains=0 ;;
    esac
    if [ "$check_contains" -eq 1 ] && [ -z "$default_branch" ]; then
        default_branch="$(git symbolic-ref --short "refs/remotes/$remote_name/HEAD" 2>/dev/null || true)"
        default_branch="${default_branch#$remote_name/}"
        if [ -z "$default_branch" ]; then
            # origin/HEAD is unset in plenty of real clones. Fall back to
            # main, then master, rather than guessing from the current branch.
            if git rev-parse --verify --quiet "refs/remotes/$remote_name/main" >/dev/null 2>&1 \
               || git rev-parse --verify --quiet refs/heads/main >/dev/null 2>&1; then
                default_branch='main'
            elif git rev-parse --verify --quiet "refs/remotes/$remote_name/master" >/dev/null 2>&1 \
                 || git rev-parse --verify --quiet refs/heads/master >/dev/null 2>&1; then
                default_branch='master'
            else
                default_branch='main'
            fi
        fi
    fi
    if [ "$check_contains" -eq 1 ] && [ "$remote_ref" = "refs/heads/$default_branch" ]; then
        check_contains=0
    fi
    if [ "$check_contains" -eq 1 ]; then
        if [ "$default_fetched" -eq 0 ]; then
            default_fetched=1
            # Hard 20s watchdog. `timeout(1)` is coreutils and is on neither
            # stock macOS nor Git for Windows, so this is plain job control:
            # both subshells redirect their own fds so a caller capturing the
            # hook's output through a pipe cannot block on a lingering child,
            # and </dev/null keeps the fetch from eating the ref list this
            # loop is reading from stdin.
            ( git fetch --quiet "$remote_name" "$default_branch" </dev/null >/dev/null 2>&1 ) >/dev/null 2>&1 &
            fetch_pid=$!
            ( sleep 20; kill "$fetch_pid" >/dev/null 2>&1 ) >/dev/null 2>&1 &
            fetch_watchdog=$!
            if wait "$fetch_pid" 2>/dev/null; then
                default_sha="$(git rev-parse --verify --quiet FETCH_HEAD 2>/dev/null || true)"
                if [ -z "$default_sha" ]; then
                    default_sha="$(git rev-parse --verify --quiet "refs/remotes/$remote_name/$default_branch" 2>/dev/null || true)"
                fi
            fi
            kill "$fetch_watchdog" >/dev/null 2>&1 || true
            wait "$fetch_watchdog" 2>/dev/null || true
        fi
        if [ -z "$default_sha" ]; then
            echo ""
            echo "REFUSING to push $local_ref: the freshness of"
            echo "$remote_name/$default_branch could not be verified —"
            echo "'git fetch $remote_name $default_branch' failed or timed out (20s)."
            echo "This gate fails closed on purpose: an unchecked branch is not"
            echo "pushable, and a push would not work without that network anyway."
            exit 1
        fi
        if ! git merge-base --is-ancestor "$default_sha" "$local_sha"; then
            behind="$(git rev-list --count "$local_sha..$default_sha" 2>/dev/null || echo '?')"
            echo ""
            echo "REFUSING to push $local_ref: this branch does not contain"
            echo "$remote_name/$default_branch — it is $behind commit(s) behind it."
            echo "Merging it as it stands would silently revert those commits."
            echo ""
            echo "Merge the default branch into your branch, here, now:"
            echo "  git fetch $remote_name"
            echo "  git merge $remote_name/$default_branch"
            echo "  # resolve the conflicts, then: git add <files> && git commit"
            echo "  git push"
            echo ""
            echo "Rebasing a published branch is NOT the fix, and neither is"
            echo "--no-verify: both hide the revert instead of resolving it."
            exit 1
        fi
        echo "Branch contains $remote_name/$default_branch."
    fi

    echo "Running ruff lint check on ${local_sha:0:12}..."
    dest="$tmp/${local_sha:0:12}"
    mkdir -p "$dest"
    git archive "$local_sha" | tar -x -C "$dest"
    ruff check "$dest" --select E,F,W --ignore E501
    rm -rf "$dest"
    echo "Lint check passed."

    # A private client name must not leave this machine in a public tree or a
    # commit message (stapel-exposure-lint EXP001/EXP002; the list is
    # ~/.stapel/private-names, outside every repo). Skipped where the tool is
    # not on PATH — a checkout without stapel-tools is not the owner's.
    if command -v stapel-exposure-lint >/dev/null 2>&1; then
        if [ -z "$remote_sha" ] || [ "$remote_sha" = "$zero" ]; then
            stapel-exposure-lint --pushed "$local_sha"
        else
            stapel-exposure-lint --pushed "$local_sha" --remote "$remote_sha"
        fi
    fi
done
